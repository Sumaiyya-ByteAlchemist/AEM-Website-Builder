# AEM Experience Modernization Agent - Environment Variables

# Claude API Key (required)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Figma Access Token (required for Figma pipeline)
FIGMA_ACCESS_TOKEN=figd_xxxxx

# AEM SDK Configuration
AEM_SDK_PATH=/path/to/aem-sdk
AEM_AUTHOR_URL=http://localhost:4502
AEM_PUBLISH_URL=http://localhost:4503
AEM_ADMIN_USER=admin
AEM_ADMIN_PASSWORD=admin

# Figma MCP Server (optional override)
FIGMA_MCP_SERVER_URL=http://localhost:3845

# Logging
LOG_LEVEL=INFO
